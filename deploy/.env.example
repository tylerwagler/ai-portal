# Copy to deploy/.env on the portal host (mode 600).

# portal_api role on the Supabase host, through Supavisor (user is <role>.<POOLER_TENANT_ID>).
# The role's password is set on the Supabase host; generate it with: openssl rand -hex 24
PORTAL_DATABASE_URL=postgres://portal_api.ai-portal:PASSWORD@ai-supabase.defense.lan:5432/postgres
# Supabase Auth itself (not its gateway), on the LAN: JWKS and the public OIDC endpoints.
SUPABASE_AUTH_URL=http://ai-supabase.defense.lan:9999
# Supabase's publishable key (public), from the Supabase host's .env
SUPABASE_PUBLISHABLE_KEY=
PUBLIC_ACCOUNT_URL=https://account.elytrondefense.com
PUBLIC_API_HOST=api.elytrondefense.com
# Same Valkey database the gate writes quotas and usage to.
PORTAL_VALKEY_URL=redis://valkey.defense.lan:6379/1
# Comma-separated OAuth client ids approved without a consent prompt (Open WebUI).
FIRST_PARTY_CLIENTS=
