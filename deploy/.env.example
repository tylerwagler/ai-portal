# Copy to deploy/.env on the portal host (mode 600).

# portal_api role on the Supabase host, through Supavisor (user is <role>.<POOLER_TENANT_ID>).
# The role's password is set on the Supabase host; generate it with: openssl rand -hex 24
PORTAL_DATABASE_URL=postgres://portal_api.ai-portal:PASSWORD@ai-supabase.defense.lan:5432/postgres
# Supabase Auth itself (not its gateway), on the LAN: JWKS and the public OIDC endpoints.
SUPABASE_AUTH_URL=http://ai-supabase.defense.lan:9999
# Supabase's publishable key (public), from the Supabase host's .env
SUPABASE_PUBLISHABLE_KEY=
PUBLIC_ACCOUNT_URL=https://account.elytrondefense.ai
PUBLIC_API_HOST=api.elytrondefense.ai
# Same Valkey database the gate writes quotas and usage to.
PORTAL_VALKEY_URL=redis://valkey.defense.lan:6379/1
# Comma-separated OAuth client ids approved without a consent prompt (Open WebUI).
FIRST_PARTY_CLIENTS=
# Microsoft Entra ID: groups decide accounts, roles and plans (portal_api/entra_sync.py). The
# "AI Portal" app registration with Graph application permissions GroupMember.Read.All and
# User.Read.All (admin consent) and its own client secret. Leave the secret empty to turn it off.
ENTRA_TENANT_ID=590a429c-bbba-49f1-b2dd-7822998989ae
ENTRA_CLIENT_ID=cea584d7-6509-4f58-819f-d83183cfa54e
ENTRA_CLIENT_SECRET=
ENTRA_USERS_GROUP=58fe32fb-94d6-4099-8bf4-47201c8de45e      # AI Users
ENTRA_ADMINS_GROUP=ba98b4f5-49a2-47b6-b105-13a9fddd4396     # AI Admins
# group=tier, first match wins: AI Plan - Unlimited
ENTRA_PLAN_GROUPS=5f6ec66e-519a-4f06-a75c-8eda93b93e22=internal
ENTRA_DEFAULT_TIER=free
ENTRA_SYNC_SECONDS=300
# Open WebUI's schema in the portal's database: the sync sets its roles too (migration 0007 grants
# portal_api what it needs). Empty means off.
OPENWEBUI_SCHEMA=openwebui
