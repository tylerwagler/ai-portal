# Environment variables used by AI Portal.
# Copy to .env.local for development (.env.local is gitignored).

# REQUIRED. Supabase anon key, read at build time.
# src/lib/supabase.ts throws at module load if this is unset, so the app will
# not start without it. In production, pass it as a Docker build arg:
#   docker build --build-arg VITE_SUPABASE_ANON_KEY=... -t ai-portal .
VITE_SUPABASE_ANON_KEY=

# OPTIONAL. Fallback base URL for the GPU telemetry API (Temper service), used
# by src/api/gpuApi.ts and the vite dev-server proxy.
#
# Only consulted when no hosts are configured in the UI; the resolution order is
#   localStorage temper_remote_hosts -> temper_remote_host -> this -> /api + /api/sparky
#
# Example: VITE_GPU_API_BASE=http://your-telemetry-host:3001
VITE_GPU_API_BASE=
