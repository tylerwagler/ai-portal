# Open WebUI (CT 113, systemd, /etc/open-webui/env): sign-in through the AI Portal.
# Open WebUI 0.11.x reads these from the environment only; the config table's oauth.* rows
# are not used for the OIDC provider. The client is registered in Supabase Auth with
#   POST /auth/v1/admin/oauth/clients  (confidential, client_secret_basic,
#   redirect_uris ["https://ai.elytrondefense.com/oauth/oidc/login/callback"])
# and its id must also be in the portal's FIRST_PARTY_CLIENTS so consent is automatic.
OPENID_PROVIDER_URL=https://account.elytrondefense.com/auth/v1/.well-known/openid-configuration
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_PROVIDER_NAME=AI Portal
OAUTH_SCOPES=openid email profile
OAUTH_CODE_CHALLENGE_METHOD=S256
OPENID_REDIRECT_URI=https://ai.elytrondefense.com/oauth/oidc/login/callback
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
WEBUI_URL=https://ai.elytrondefense.com
