# Edge for the AI portal. TLS ends at the Cloudflare tunnel; this listens on plain HTTP.
# Rendered by the nginx image at start: ${SUPABASE_AUTH_URL}, ${SUPABASE_GATEWAY_URL} and ${GATE_URL} come from the environment.
#   account.elytrondefense.com  portal web app, Supabase Auth, portal-api
#   api.elytrondefense.com      switchyard-gate (/v1), portal-api (/portal, for the CLI), installers

# Docker's resolver, so upstreams are looked up per request and nginx starts even if one is down.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80 default_server;
    server_name account.elytrondefense.com;
    root /usr/share/nginx/account;

    set $auth ${SUPABASE_AUTH_URL};
    set $supabase ${SUPABASE_GATEWAY_URL};
    set $portal_api http://portal-api:8200;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    # Public OIDC endpoints go straight to Auth: Supabase's gateway demands an apikey on
    # /auth/v1/*, which browsers and OAuth clients (Open WebUI) never send here.
    location ~ ^/auth/v1/(\.well-known/openid-configuration|oauth/authorize|oauth/token|oauth/userinfo)$ {
        proxy_pass $auth/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /auth/v1/ {
        proxy_pass $supabase;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /.well-known/oauth-authorization-server {
        proxy_pass $supabase;
        proxy_set_header Host $host;
    }

    location /portal/ {
        proxy_pass $portal_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}

server {
    listen 80;
    server_name api.elytrondefense.com;

    set $gate ${GATE_URL};
    set $portal_api http://portal-api:8200;

    # Model traffic: long, streamed responses and large request bodies.
    location /v1/ {
        proxy_pass $gate;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        client_max_body_size 64m;
    }

    location = /health {
        proxy_pass $gate;
    }

    location /portal/ {
        proxy_pass $portal_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /install/ {
        root /usr/share/nginx;
        default_type text/plain;
        add_header Cache-Control "no-cache";
    }

    location / {
        return 404;
    }
}
